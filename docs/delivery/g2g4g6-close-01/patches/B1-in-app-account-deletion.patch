+    rejected: "This account cannot be deleted here. Contact HealthTimes support.",
+    none: "There is no deletion request for this account."
+  };
+  const mapped: AccountDeletionState["status"] = status === "data_erased" ? "requested" : status === "rejected" ? "error" : (status as AccountDeletionState["status"]);
+  return { status: mapped, message: messages[status] ?? "There is no deletion request for this account.", requestId: row.requestId, cancelWindowEndsAt: row.cancelWindowEndsAt };
