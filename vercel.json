{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/article/:id*",
      "destination": "/article/fallback"
    },
    {
      "source": "/author/:slug*",
      "destination": "/author/fallback"
    },
    {
      "source": "/studio/staff/:staffId*",
      "destination": "/studio/staff/fallback"
    }
  ]
}
