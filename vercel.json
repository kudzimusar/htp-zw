{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --no-audit --no-fund && npm install --prefix apps/mobile --no-audit --no-fund",
  "buildCommand": "node scripts/web/build-phase11-vercel.js",
  "outputDirectory": "apps/mobile/dist",
  "functions": {
    "api/web.js": {
      "includeFiles": "apps/mobile/dist/+not-found.html",
      "maxDuration": 15
    },
    "api/public.js": {
      "maxDuration": 15
    },
    "api/newsroom.js": {
      "maxDuration": 30
    },
    "api/communications.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/newsroom.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, private"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; connect-src 'self'; font-src 'self' data:"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/api/newsroom",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, private"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/api/communications",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, private"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/public?kind=sitemap"
    },
    {
      "source": "/feed",
      "destination": "/api/public?kind=feed"
    },
    {
      "source": "/__ag05/direct-ad-preview",
      "destination": "/api/public?kind=ad"
    },
    {
      "source": "/explore",
      "destination": "/explore.html"
    },
    {
      "source": "/search",
      "destination": "/search.html"
    },
    {
      "source": "/live",
      "destination": "/live.html"
    },
    {
      "source": "/watch",
      "destination": "/watch.html"
    },
    {
      "source": "/my",
      "destination": "/my.html"
    },
    {
      "source": "/premium",
      "destination": "/premium.html"
    },
    {
      "source": "/notifications",
      "destination": "/notifications.html"
    },
    {
      "source": "/notification-settings",
      "destination": "/notification-settings.html"
    },
    {
      "source": "/saved",
      "destination": "/saved.html"
    },
    {
      "source": "/listen",
      "destination": "/listen.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/account-access",
      "destination": "/account-access.html"
    },
    {
      "source": "/appearance",
      "destination": "/appearance.html"
    },
    {
      "source": "/authors",
      "destination": "/authors.html"
    },
    {
      "source": "/devices-sessions",
      "destination": "/devices-sessions.html"
    },
    {
      "source": "/edition",
      "destination": "/edition.html"
    },
    {
      "source": "/growth-status",
      "destination": "/growth-status.html"
    },
    {
      "source": "/onboarding",
      "destination": "/onboarding.html"
    },
    {
      "source": "/system-status",
      "destination": "/system-status.html"
    },
    {
      "source": "/article/:id",
      "destination": "/article/[id].html"
    },
    {
      "source": "/:path*/",
      "destination": "/api/web?path=/:path*/"
    },
    {
      "source": "/:path*",
      "destination": "/api/web?path=/:path*"
    }
  ]
}
